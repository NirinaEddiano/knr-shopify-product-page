  .knr-after-img-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .knr-after-img {
    width: 1440px; /* Garde la même largeur absolue pour éviter la déformation */
    max-width: none;
    height: 130%;
    object-fit: cover;
    object-position: center;
  }

  /* Premier plan (Image AVANT) */
  .knr-before-img-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%; /* Largeur par défaut de 50% */
    height: 100%;
    overflow: hidden;
    z-index: 2;
  }

  .knr-before-img {
