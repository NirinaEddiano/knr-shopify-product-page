<style>
  /* ---------------------------------------------------------
     1. SECTIONS GLOBALES ET REGLAGE DE HAUTEUR (CONFORME FIGMA)
     --------------------------------------------------------- */
  .section-product-main {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Section 1 : Hero (Hauteur fixée à 760px comme sur Figma) */
  .knr-hero-section {
    width: 100vw;
    height: 760px; /* Réduit pour s'adapter parfaitement sans déborder */
    position: relative;
    left: 50%;
    margin-left: -50vw;
    background: 
      linear-gradient(rgba(0, 0, 0, 0.24) 0%, rgba(0, 0, 0, 0) 100%),
      url("{{ 'upscale_image.png' | asset_url }}") no-repeat center center;
    background-size: cover;
    box-sizing: border-box;
    border-bottom: 1px solid #FFFFFF;
  }

  /* Section 2 : Bas (Description & Carrousel) */
  .knr-bottom-section {
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
    background-color: transparent; 
    box-sizing: border-box;
  }

  /* Conteneurs de grille de 1440px */
  .knr-hero-container {
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    height: 100%;
    padding: 0 40px;
    position: relative; /* Point d'ancrage absolu pour la fiche produit */
    box-sizing: border-box;
  }

  .knr-bottom-container {
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    padding: 0 40px 0px 40px !important;
    display: flex;
    justify-content: flex-end;
    align-items: stretch;        /* Force les colonnes de gauche et de droite à faire la même hauteur */
    box-sizing: border-box;
  }

  /* ---------------------------------------------------------
     2. LIAISON DROITE & TYPOGRAPHIES FLUIDES (ADAPTATIVE)
     --------------------------------------------------------- */
  
  /* Largeur adaptative : Ajuste de 400px à 500px selon la résolution */
  .knr-details-column {
    width: clamp(400px, 28vw, 500px); 
    flex-shrink: 0;
  }

  /* Bloc supérieur (Haut) - HAUTEUR RÉDUITE EN HAUT */
   .knr-product-sheet-top {
    width: clamp(400px, 28vw, 500px); 
    height: auto;               /* Hauteur naturelle basée sur le contenu pour éviter tout vide étiré */
    position: absolute;
    bottom: 0;                  /* Reste parfaitement alignée en bas */
    right: 40px;                
    background-color: #FFFFFF;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 0px; 
    border-bottom-right-radius: 0px;
    padding: 40px;              
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 24px;                  /* Écart fixe et compact entre le haut et le bas */
    z-index: 10;
  }

  /* Groupe haut : Textes de détails */
  .knr-sheet-top-group {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.2vw, 18px); 
  }

  /* Groupe bas : Sélecteurs et bouton */
  .knr-sheet-bottom-group {
    margin-top: auto; 
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.2vw, 18px); 
  }

   .knr-product-sheet-bottom {
    width: clamp(400px, 28vw, 500px); 
    background-color: #FFFFFF;
    border-top-left-radius: 0px; 
    border-top-right-radius: 0px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding: 20px 40px 40px 40px; 
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 40px;
    height: 657px !important;       /* Fixé à 657px (617px de hauteur + 40px d'écart du haut) */
  }

  /* Fil d'Ariane (Breadcrumb) */
  .knr-product-breadcrumb {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(10px, 0.75vw, 11px); 
    line-height: 14px;
    letter-spacing: -2%;
    color: #B5A282;
    margin-bottom:20px;
  }

  /* Badges / Tags */
  .knr-product-tags {
    display: flex;
    gap: 8px;
    margin-bottom:15px;
  }

  .knr-tag {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(11px, 0.8vw, 13px); 
    line-height: 100%;
    letter-spacing: -2%;
    text-transform: uppercase;
    color: #000000;
    border: 0.8px solid #000000;
    padding: 4px 10px; 
    display: inline-block;
  }

  /* MODIF : Aligné en Flex avec les étoiles et avis à droite */
  .knr-product-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
    margin-bottom:12px;
  }

  .knr-product-title {
    flex: 1;
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(22px, 1.8vw, 30px); 
    line-height: 1.25;
    letter-spacing: -2%;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
  }

  .knr-product-rating {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    flex-shrink: 0;
    gap: 4px;
    font-family: 'Inter', sans-serif;
    font-size: clamp(10px, 0.75vw, 11px);
  }

  .knr-stars {
    color: #B5A282;
    font-weight: bold;
  }

  .knr-rating-score {
    color: #000000;
    margin-left: 2px;
  }

  .knr-reviews-count {
    color: #B5A282;
  }

  /* Diagnostics Yuka / INCI */
  .knr-ratings-row {
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 0.8vw, 13px); 
    color: #000000;
    border-bottom: 0.8px solid #E0DDD6;
    padding-bottom: 16px;
  }

  .knr-bold {
    font-weight: 700;
  }

  /* Descriptif d'introduction */
  .knr-product-intro {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(11px, 0.8vw, 13px); 
    line-height: 1.6; 
    letter-spacing: -2%;
    color: #000000;
  }

  /* Sélection de Variantes & Prix */
  .knr-variants-price-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 0.8px solid #E0DDD6;
    padding-top: 20px;
  }

  .knr-option-title {
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 0.8vw, 13px); 
    font-weight: 500;
    color: #000000;
  }

  .knr-variant-selector {
    display: flex;
    gap: 12px;
  }

  .knr-variant-btn {
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 0.8vw, 13px); 
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    color: #6E6E6E;
    padding: 4px 0px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .knr-variant-btn.active {
    color: #000000;
    border-bottom: 1px solid #000000;
    font-weight: 600;
  }

  .knr-price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .knr-price {
    font-family: 'Inter', sans-serif;
    font-size: clamp(22px, 1.8vw, 28px); 
    font-weight: 600;
    color: #000000;
  }

  .knr-compare-price {
    font-family: 'Inter', sans-serif;
    font-size: clamp(13px, 0.9vw, 16px); 
    text-decoration: line-through;
    color: #B5A282;
  }

  .knr-unit-price {
    font-family: 'Inter', sans-serif;
    font-size: clamp(10px, 0.75vw, 11px); 
    color: #B5A282;
  }

  /* Bouton d'ajout au panier */
  .knr-add-to-cart-btn {
    width: 100%;
    height: clamp(44px, 3.5vw, 54px); 
    background-color: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 2px;
    font-family: 'Inter', sans-serif;
    font-weight: bold;
    font-size: clamp(11px, 0.8vw, 13px); 
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .knr-add-to-cart-btn:hover {
    opacity: 0.9;
  }

  .knr-add-to-cart-btn:disabled {
    background-color: #6E6E6E;
    cursor: not-allowed;
  }

  /* Information de livraison et de stock */
  .knr-stock-info {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(10px, 0.75vw, 11px); 
    line-height: 14px;
    letter-spacing: -2%;
    text-align: center;
    color: #000000;
  }

  /* Accordéons */
  .knr-accordion {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #E0DDD6;
  }

   .knr-bottom-left-photos {
    display: flex;
    gap: 16px;                      
    flex: 1;
    margin-left: calc(-50vw + 50%); 
    margin-right: 0 !important;     
    margin-top: 20px;               
    height: 617px;                  /* Fixé à 617px */
  }


  .knr-bottom-photo-wrapper {
    flex: 1;
    height: 100%;
    overflow: hidden;
    background-color: #F4F1EB;
  }

  .knr-bottom-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .knr-accordion-item {
    border-bottom: 1px solid #E0DDD6;
    margin-bottom: 10px;  
  }

  .knr-accordion-header {
    width: 100%;
    background: transparent;
    border: none;
    padding: 16px 0; 
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Inter', sans-serif;
    font-size: clamp(12px, 0.9vw, 14px); 
    font-weight: 400;
    color: #000000;
    cursor: pointer;
  }

  .knr-accordion-content {
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 0.8vw, 13px); 
    line-height: 1.6; 
    color: #4A4A4A;
    padding-bottom: 16px;
    display: none;
  }

   .knr-accordion-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .knr-accordion-icon-svg {
    width: 14px;
    height: 14px;
    transition: transform 0.25s ease; /* Rotation fluide de l'icône */
    display: block;
    color: #000000;
  }

  .knr-accordion-item.active .knr-accordion-icon-svg {
    transform: rotate(180deg);
  }

  /* Carrousel */
  .knr-carousel-wrapper {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .knr-carousel-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .knr-carousel-title-row h2 {
    font-family: 'Inter', sans-serif;
    font-size: clamp(12px, 0.9vw, 14px); 
    font-weight: 500;
    letter-spacing: 0.5px;
    color: #000000;
    margin: 0;
  }

  .knr-carousel-icon-arrow {
    font-size: 12px;
    color: #000000;
  }

  .knr-carousel-track {
    display: flex;
    gap: 16px; 
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 10px;
  }

  .knr-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .knr-carousel-card {
    flex: 0 0 calc(46% - 8px); 
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .knr-card-img-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 125%; 
    background-color: #F4F1EB;
    overflow: hidden;
  }

  .knr-card-img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%; 
    height: 90%;
    object-fit: contain; 
    object-position: center;
    background-color: #F4F1EB;
  }

  /* Bouton d'ajout rapide "+" */
  .knr-quick-add-btn {
    position: absolute;
    bottom: 12px;
    left: 12px;
    width: clamp(28px, 2vw, 32px); 
    height: clamp(28px, 2vw, 32px); 
    background-color: #FFFFFF;
    border: none;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    color: #000000;
    transition: transform 0.2s ease, background-color 0.2s ease;
    z-index: 2;
  }

  .knr-quick-add-btn:hover {
    transform: scale(1.05);
    background-color: #F4F1EB;
  }

  .knr-plus-svg {
    width: 14px; 
    height: 14px;
  }

  .knr-card-info {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: 'Inter', sans-serif;
    font-size: clamp(11px, 0.8vw, 12px); 
    line-height: 14px;
  }

  .knr-card-title {
    font-weight: 400;
    color: #000000;
  }

  .knr-card-price {
    font-weight: 400;
    color: #6E6E6E;
  }

  /* ---------------------------------------------------------
     5. RESPONSIVE DESIGN (MOBILE / TABLETTE)
     --------------------------------------------------------- */
  @media (max-width: 991px) {
    .knr-hero-section {
      height: auto;
      padding: 100px 20px 40px;
    }
    .knr-hero-container {
      padding: 0;
      justify-content: center;
      align-items: center;
    }
    .knr-bottom-container {
      padding: 40px 20px;
      justify-content: center;
    }
    .knr-product-sheet-top {
      height: auto;
      position: relative; /* Désactive le positionnement absolu sur mobile */
      bottom: auto;
      right: auto;
      border-bottom-left-radius: 4px;
      border-bottom-right-radius: 4px;
      padding-bottom: 40px;
      padding-top: 40px;
    }
    .knr-product-sheet-bottom {
      border-top-left-radius: 4px;
      border-top-right-radius: 4px;
      padding-top: 40px;
    }
    .knr-product-sheet-top, .knr-product-sheet-bottom {
      width: 100%;
      max-width: 480px;
    }
    .knr-carousel-card {
      flex: 0 0 calc(70% - 8px);
    }
  }
  


   /* ---------------------------------------------------------
     1. STRUCTURE DE LA SECTION ENGAGEMENT (HAUTEUR 720PX)
     --------------------------------------------------------- */
  .section-product-engagement {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .knr-engagement-section {
    width: 100vw;
    height: 720px; /* FIXE : Conforme aux spécifications Figma */
    position: relative;
    left: 50%;
    margin-left: -50vw;
    /* Image de fond ba9711f8e3188ac9a1a699bed15347ddc4f5dabe.png avec fallback sécurisé */
    background: 
      linear-gradient(rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.1) 100%),
      url("{{ 'ba9711f8e3188ac9a1a699bed15347ddc4f5dabe.png' | asset_url }}") no-repeat center center;
    background-size: cover;
    box-sizing: border-box;
    border-bottom: 1px solid #E0DDD6;
  }

  .knr-engagement-container {
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    height: 100%;
    padding: 0 40px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* ---------------------------------------------------------
     2. ZONE GAUCHE (TEXTE ENPETIT & LIGNE DE SÉPARATEUR)
     --------------------------------------------------------- */
  .knr-engagement-left {
    width: 250px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .knr-engagement-sub {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 11px;
    line-height: 14px;
    color: #FCFBFC;
    opacity: 0.8;
  }

  .knr-engagement-line {
    width: 32px;
    height: 1px;
    background-color: #FCFBFC;
  }

  /* ---------------------------------------------------------
     3. ZONE DROITE (PARAGRAPHE ENGAGEMENT ET SIGNATURE)
     --------------------------------------------------------- */
  .knr-engagement-right {
    width: 561px; /* Alignement parfait sur la largeur de la fiche produit du bas */
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-sizing: border-box;
  }

  /* Spécifications typographiques Figma exactes */
  .knr-engagement-text {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 32px;      /* Conforme Figma */
    line-height: 40px;    /* Conforme Figma */
    letter-spacing: -4%;  /* Conforme Figma */
    color: #FFFFFF;
    margin: 0;
  }

  .knr-engagement-author {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 12px;
    color: #E0DDD6;
  }

  /* ---------------------------------------------------------
     4. FICHE PRODUIT FLOTTANTE HORIZONTALE (HAUTEUR 120PX)
     --------------------------------------------------------- */
  .knr-floating-product-card {
    position: absolute;
    bottom: -60px; /* Chevauchement de moitié (120px / 2) */
    right: 40px;
    width: 561px;  /* S'aligne parfaitement sous la largeur du paragraphe de droite */
    height: 120px; /* Conforme Figma */
    background-color: #FFFFFF;
    border: 1px solid #E0DDD6;
    border-radius: 4px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    display: flex;
    align-items: center;
    padding: 12px 24px;
    box-sizing: border-box;
    justify-content: space-between;
    gap: 16px;
    z-index: 20;
  }

  .knr-float-img-wrapper {
    position: relative;
    width: 96px;
    height: 96px;
    background-color: #F4F1EB;
    overflow: hidden;
    flex-shrink: 0;
  }

  .knr-float-img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 85%;
    height: 85%;
    object-fit: contain;
  }

  .knr-float-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    flex-grow: 1;
  }

  .knr-float-title {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 14px;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
  }

  /* Tailles alignées horizontalement */
  .knr-float-sizes {
    display: flex;
    gap: 12px;
  }

  .knr-float-size-btn {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    color: #6E6E6E;
    padding: 2px 0px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .knr-float-size-btn.active {
    color: #000000;
    border-bottom: 1px solid #000000;
    font-weight: 600;
  }

  .knr-float-price {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #000000;
  }

  .knr-float-atc-btn {
    background-color: #000000;
    color: #FFFFFF;
    font-family: 'Inter', sans-serif;
    font-weight: bold;
    font-size: 11px;
    border: none;
    border-radius: 2px;
    height: 44px;
    padding: 0 24px;
    cursor: pointer;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .knr-float-atc-btn:hover {
    opacity: 0.9;
  }

  /* Responsive mobile */
  @media (max-width: 991px) {
    .knr-engagement-section {
      height: auto;
      padding: 80px 20px 100px;
    }
    .knr-engagement-container {
      flex-direction: column;
      gap: 40px;
      padding: 0;
    }
    .knr-engagement-left, .knr-engagement-right {
      width: 100%;
    }
    .knr-floating-product-card {
      width: calc(100% - 40px);
      left: 20px;
      right: 20px;
      bottom: -60px;
    }
  }

  @media (max-width: 767px) {
  /* 1. Force l'affichage du bloc prix à côté du titre */
  .knr-mobile-only-price {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end !important;
    text-align: right !important;
    margin-left: auto !important;
  }

  .knr-price {
    font-size: 16px !important;
    color: #000000 !important;
    font-weight: 600 !important;
  }

  /* 2. Ajustement du conteneur Titre + Prix */
  .knr-product-title-row {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: space-between !important;
    align-items: flex-start !important;
  }

  .knr-product-title {
    font-size: 15px !important;
    max-width: 65% !important; /* Laisse de la place au prix à droite */
    margin: 0 !important;
  }

  /* 3. Avis et Étoiles passent en dessous sur toute la largeur */
  .knr-product-rating {
    width: 100% !important;
    display: flex !important;
    flex-direction: row !important;
    justify-content: flex-start !important;
    gap: 8px !important;
    margin-top: 8px !important;
  }
}

  @media (max-width: 767px) {
  /* On force les deux fiches à avoir exactement la même largeur calculée */
  .knr-product-sheet-top, 
  .knr-product-sheet-bottom {
    width: calc(100vw - 32px) !important;
    max-width: calc(100vw - 32px) !important;
    margin-left: auto !important;
    margin-right: auto !important;
    box-sizing: border-box !important;
  }

  /* On supprime les paddings des conteneurs parents qui pourraient décaler la fiche 2 */
  .knr-hero-container,
  .knr-bottom-container {
    padding: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  /* On s'assure que la colonne de détails n'ajoute pas de contrainte */
  .knr-details-column {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }
}


/* --- PROTECTION PC (Cache le nouveau bloc prix) --- */
.knr-mobile-price-stack {
  display: none !important;
}

/* --- CORRECTION MOBILE --- */
@media (max-width: 767px) {
  /* 1. Cache l'ancien prix du bas */
  .knr-variants-price-block .knr-price-row, 
