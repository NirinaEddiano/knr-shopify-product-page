<style>
  /* Neutralise le conteneur Shopify et bloque les scripts JS du thème */
  #shopify-section-knr-header,
  [id*="shopify-section-knr-header"] {
    position: static !important;
    transform: none !important; /* Bloque les translations du thème lors du défilement */
  }

  .knr-header-outer {
    width: 100%;                  
    height: 56px;                 
    position: absolute !important;  /* Force absolue pour écraser les styles injectés en JS */
    top: 32px !important;           /* Reste ancré en haut sous la barre d'annonce */
    left: 0 !important;                      
    transform: none !important;     /* Évite que le header ne redescende au scroll */
    z-index: 10;
  }

  .knr-header-container {
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    height: 100%;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    position: relative;           
  }

  .knr-header-left {
    display: flex;
    align-items: center;
  }

  .knr-header-logo-link {
    font-family: var(--font-inter);
    font-weight: 300;
    font-size: 18px;
    color: #FCFBFC;
    text-decoration: none;
    letter-spacing: -0.5px;
    white-space: nowrap;
  }

  .knr-header-center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .knr-header-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .knr-header-menu {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .knr-menu-item-link {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 12px;
    color: #FFFFFF;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .knr-menu-item-link:hover {
    opacity: 0.8;
  }

  .knr-icon-link {
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
    position: relative;
  }

  .knr-icon-link:hover {
    opacity: 0.8;
  }

  .knr-icon-svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2px;
  }

  .knr-cart-badge {
    position: absolute;
    top: -4px;
    right: -6px;
    background-color: #FFFFFF;
    color: #000000;
    font-family: 'Inter', sans-serif;
    font-size: 8px;
    font-weight: bold;
    border-radius: 50%;
    width: 12px;
    height: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Cache le burger sur PC */
.knr-mobile-burger {
  display: none;
}

@media (max-width: 991px) {
  /* 1. Enlever le menu du centre */
  .knr-header-center {
    display: none !important;
  }

  /* 2. Ajuster le conteneur mobile */
  .knr-header-container {
    padding: 0 20px; /* Moins de marge sur les côtés sur mobile */
  }

  /* 3. Masquer l'icône compte pour libérer de l'espace (comme sur Figma) */
  .knr-desktop-only {
    display: none !important;
  }

  /* 4. Afficher et styliser le burger à droite */
  .knr-mobile-burger {
    display: flex;
    background: none;
    border: none;
    padding: 0;
    margin-left: 5px;
    cursor: pointer;
  }

  .knr-header-right {
    gap: 15px; /* Espacement entre les icônes sur mobile */
  }

  .knr-header-logo-link {
    font-size: 16px; /* Légèrement plus petit pour mobile */
  }
}
</style>

<header class="knr-header-outer">
  <div class="knr-header-container">
    
    <div class="knr-header-left">
      <a href="/" class="knr-header-logo-link">maison célestine</a>
    </div>

    <div class="knr-header-center">
      <ul class="knr-header-menu">
        {%- if section.settings.menu != blank -%}
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" class="knr-menu-item-link">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="#" class="knr-menu-item-link">Produits</a></li>
          <li><a href="#" class="knr-menu-item-link">Diagnostique</a></li>
          <li><a href="#" class="knr-menu-item-link">La marque</a></li>
          <li><a href="#" class="knr-menu-item-link">Journal</a></li>
        {%- endif -%}
      </ul>
    </div>

    <div class="knr-header-right">
  <!-- Icône Localisation -->
  <a href="/pages/nos-adresses" class="knr-icon-link" aria-label="Nos adresses">
    <svg class="knr-icon-svg" viewBox="0 0 24 24" width="18" height="18">
      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>

  <!-- Icône Compte (Masquée sur mobile via CSS) -->
  <a href="/account" class="knr-icon-link knr-desktop-only" aria-label="Mon compte">
    <svg class="knr-icon-svg" viewBox="0 0 24 24" width="16" height="16">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>

  <!-- Icône Recherche -->
  <a href="/search" class="knr-icon-link" aria-label="Recherche">
    <svg class="knr-icon-svg" viewBox="0 0 24 24" width="18" height="18">
      <circle cx="11" cy="11" r="8" stroke-linecap="round" stroke-linejoin="round"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>

  <!-- Icône Panier -->
  <a href="/cart" class="knr-icon-link" aria-label="Panier">
    <svg class="knr-icon-svg" viewBox="0 0 24 24" width="18" height="18">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="knr-cart-badge">{{ cart.item_count }}</span>
  </a>

  <!-- BOUTON BURGER (Apparaît uniquement sur mobile) -->
  <button class="knr-mobile-burger" aria-label="Menu">
    <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M1 1H19" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M1 11H19" stroke="white" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  </button>
</div>

  </div>
</header>

{% schema %}
{
  "name": "KNR Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu de navigation",
      "default": "main-menu"
    }
  ]
}
{% endschema %}