<!-- ==========================================
     A. FICHE PRODUIT : PARTIE SUPERIEURE (HERO)
     ========================================== -->
<div class="knr-hero-section">
  <div class="knr-hero-container">
    
    <!-- Fiche produit haute -->
    <div class="knr-product-sheet-top">
      
      <!-- Groupe haut : Textes et détails du produit -->
      <div class="knr-sheet-top-group">
        <!-- Fil d'Ariane -->
        <div class="knr-product-breadcrumb">Soins anti-âge / Collection Cactus</div>
        
        <!-- Badges -->
        <div class="knr-product-tags">
          <span class="knr-tag">UNIFIE</span>
          <span class="knr-tag">PROTÈGE</span>
        </div>
        
        <!-- Titre et Avis -->
        <!-- CHANGER CE BLOC DANS LE HTML -->
<div class="knr-product-title-row">
  <!-- Titre à gauche -->
  <h1 class="knr-product-title">{{ product.title | default: "SÉRUM PRÉCIEUX RÉGÉNÉRANT" }}</h1>
  
  <!-- Bloc Prix à droite (Stack vertical) -->
  <div class="knr-mobile-price-stack">
      <div class="knr-price-line">
          <span class="knr-price">{{ product.selected_or_first_available_variant.price | money }}</span>
          <span class="knr-compare-price">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
      </div>
      <div class="knr-unit-price-mobile">75,00 € par 100 mL</div>
  </div>

  <!-- Ligne des avis en dessous -->
  <div class="knr-product-rating">
    <div class="knr-stars">★★★★★ <span class="knr-rating-score">4.7</span></div>
    <span class="knr-reviews-count">200 avis</span>
  </div>
</div>
        
        <!-- Yuka & INCI -->
        <div class="knr-ratings-row">
          <span class="knr-bold">Yuka</span> 100/100 · <span class="knr-bold">INCI Beauty</span> 20/20
        </div>
        
        <!-- Petite description descriptive -->
        <div class="knr-product-intro">
          {{ product.description | default: "Une huile anti-âge sèche ultra fine qui travaille en synergie avec la peau pour la maintenir ferme, pleine de vitalité tout en lissant les rides." }}
        </div>
      </div>
      
      <!-- Groupe bas : Options de tailles, Prix et Ajouter au panier -->
      <div class="knr-sheet-bottom-group">
        <!-- Taille & Prix -->
        <div class="knr-variants-price-block">
          <div class="knr-option-title">Taille</div>
          
          <!-- Sélecteur de taille dynamique -->
          <div class="knr-variant-selector">
            {%- for variant in product.variants -%}
              <button type="button" 
                      class="knr-variant-btn {% if forloop.first %}active{% endif %}" 
                      data-id="{{ variant.id }}" 
                      data-price="{{ variant.price | money }}"
                      data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}">
                {{ variant.title }}
              </button>
            {%- else -%}
              <!-- Fallbacks de développement local -->
              <button type="button" class="knr-variant-btn active" data-id="123456789" data-price="75,00 €" data-compare-price="85,00 €">15 mL</button>
              <button type="button" class="knr-variant-btn" data-id="987654321" data-price="250,00 €" data-compare-price="">150 mL</button>
            {%- endfor -%}
          </div>
          
          <!-- Affichage des prix -->
          <div class="knr-price-row">
            <span class="knr-price" id="knr-active-price">
              {{ product.selected_or_first_available_variant.price | default: 7500 | money }}
            </span>
            <span class="knr-compare-price" id="knr-compare-price">
              {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                {{ product.selected_or_first_available_variant.compare_at_price | money }}
              {%- else -%}
                {%- if product.variants.size == 0 -%}85,00 €{%- endif -%}
              {%- endif -%}
            </span>
          </div>
          <div class="knr-unit-price" id="knr-unit-price">
            75,00 € par 100 mL
          </div>
        </div>
        
        <!-- Formulaire et Bouton d'ajout au panier AJAX -->
        <div class="knr-atc-wrapper">
          <form id="knr-main-atc-form">
            <input type="hidden" name="id" id="knr-variant-id-input" value="{{ product.selected_or_first_available_variant.id | default: 123456789 }}">
            <button type="submit" class="knr-add-to-cart-btn" id="knr-main-submit-btn">Ajouter au panier</button>
          </form>
        </div>
        
        <!-- État du stock -->
        <div class="knr-stock-info">
          En stock, livraison estimée <span class="knr-bold">Mercredi 25 février</span>.
        </div>
      </div>

    </div>
  </div>
</div>

