<!-- Scripts interactifs locaux -->
<script>
  document.addEventListener('DOMContentLoaded', () => {

    /* 1. COMPORTEMENT DYNAMIQUE DU BOUTON "CHARGER PLUS" */
    const loadMoreBtn = document.getElementById('knr-load-more-trigger');
    const hiddenCards = document.querySelectorAll('.knr-review-card.knr-hidden');

    if (loadMoreBtn && hiddenCards.length > 0) {
      loadMoreBtn.addEventListener('click', () => {
        hiddenCards.forEach(card => {
          card.style.display = 'flex';
          // Petite temporisation pour animer l'apparition
          setTimeout(() => {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
            card.classList.remove('knr-hidden');
          }, 50);
        });
        // Masque le bouton Charger Plus une fois que tout est révélé
        loadMoreBtn.style.display = 'none';
      });
    }

    /* 2. GESTION DE LA FENÊTRE MODALE D'AVIS */
    const modal = document.getElementById('knr-write-review-modal');
    const openBtn = document.getElementById('knr-write-review-btn');
    const closeBtn = document.getElementById('knr-modal-close-trigger');

    if (modal && openBtn && closeBtn) {
      openBtn.addEventListener('click', () => {
        modal.style.display = 'flex';
      });

      closeBtn.addEventListener('click', () => {
        modal.style.display = 'none';
      });

      // Fermeture au clic sur le fond sombre de la modale
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.style.display = 'none';
        }
      });
    }

    /* 3. LOGIQUE D'AJOUT DYNAMIQUE EN TEMPS RÉEL DU NOUVEL AVIS CLIENT */
    const form = document.getElementById('knr-submit-review-form');
    const reviewsListContainer = document.getElementById('knr-reviews-container-list');
    const totalCountEl = document.getElementById('knr-total-reviews-count');

    if (form && reviewsListContainer) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Récupération des valeurs du formulaire
        const selectedStars = document.getElementById('knr-form-stars').value;
        const authorName = document.getElementById('knr-form-name').value;
        const reviewTitle = document.getElementById('knr-form-title').value;
        const reviewText = document.getElementById('knr-form-comment').value;

        // Génère la date d'aujourd'hui au format JJ/MM/AA
        const today = new Date();
        const dd = String(today.getDate()).padStart(2, '0');
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const yy = String(today.getFullYear()).slice(-2);
        const formattedDate = `${dd}/${mm}/${yy}`;

        // Construction du nouvel avis au format HTML conforme
        const newCard = document.createElement('div');
        newCard.className = 'knr-review-card';
        newCard.style.opacity = '0';
        newCard.style.transform = 'translateY(-10px)';

        newCard.innerHTML = `
          <div class="knr-review-top">
            <div class="knr-review-stars">${selectedStars}</div>
            <span class="knr-review-date">${formattedDate}</span>
          </div>
          <div class="knr-review-author-row">
            <span>${authorName}</span>
            <span class="knr-verified-badge">VÉRIFIÉ</span>
          </div>
          <h4 class="knr-review-title">${reviewTitle}</h4>
          <p class="knr-review-text">${reviewText}</p>
        `;

        // Insère dynamiquement le nouvel avis tout en haut de la liste
        reviewsListContainer.insertBefore(newCard, reviewsListContainer.firstChild);

        // Transition d'apparition fluide
        setTimeout(() => {
          newCard.style.transition = 'all 0.4s ease';
          newCard.style.opacity = '1';
          newCard.style.transform = 'translateY(0)';
        }, 50);

        // Ferme la modale et réinitialise le formulaire
        modal.style.display = 'none';
        form.reset();

        // Met à jour incrémentalement le nombre d'avis total affiché
        if (totalCountEl) {
          totalCountEl.textContent = "Basé sur 201 avis";
        }
      });
    }

  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    /* LOGIQUE DES ACCORDÉONS FAQ UNIQUE (N'interfère pas avec les autres FAQ) */
    const faqHeaders = document.querySelectorAll('.knr-faq-header');

    faqHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const currentItem = header.parentElement;
        const isActive = currentItem.classList.contains('active');

        // Fermer tous les autres accordéons
        document.querySelectorAll('.knr-faq-item').forEach(item => {
          item.classList.remove('active');
          item.querySelector('.knr-faq-content').style.display = 'none';
        });

        // Ouvrir l'accordéon sélectionné s'il était fermé
        if (!isActive) {
          currentItem.classList.add('active');
          currentItem.querySelector('.knr-faq-content').style.display = 'block';
        }
      });
    });
  });
</script>

<!-- Scripts interactifs locaux -->
<script>
  document.addEventListener('DOMContentLoaded', () => {

    /* 1. LOGIQUE COMPARAISON INTERACTIVE AVANT / APRES */
    const slider = document.querySelector('.knr-comparison-slider');
    const beforeWrapper = document.getElementById('knr-before-wrapper');
    const handle = document.getElementById('knr-slider-handle');

    if (slider && beforeWrapper && handle) {
      let isDragging = false;

      const updateSlider = (clientX) => {
        const rect = slider.getBoundingClientRect();
        let position = ((clientX - rect.left) / rect.width) * 100;

        // Limites du glissement entre 0% et 100%
        if (position < 0) position = 0;
        if (position > 100) position = 100;

        beforeWrapper.style.width = `${position}%`;
        handle.style.left = `${position}%`;
      };

      // Gestionnaires de souris
      slider.addEventListener('mousedown', (e) => {
        isDragging = true;
        updateSlider(e.clientX);
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        updateSlider(e.clientX);
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });

      // Gestionnaires tactiles pour mobiles
      slider.addEventListener('touchstart', (e) => {
        isDragging = true;
        updateSlider(e.touches[0].clientX);
      });

      window.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        updateSlider(e.touches[0].clientX);
      });

      window.addEventListener('touchend', () => {
        isDragging = false;
      });
    }

    /* 2. LOGIQUE CAROUSEL TEMOIGNAGES */
    const testimonials = [
      {
        author: "Clara T.",
        text: "J'utilise ce sérum depuis trois mois et la différence est saisissante. Mes rides d'expression se sont considérablement atténuées et mon teint a retrouvé une luminosité que je n'avais plus depuis des années. Une texture soyeuse qui pénètre instantanément. Je ne peux plus m'en passer."
      },
      {
        author: "Sophie R.",
        text: "Une formule d'une douceur exceptionnelle. Ma peau est visiblement repulpée au réveil et l'aspect fatigué de mes traits a totalement disparu après seulement deux semaines d'utilisation quotidienne."
      },
      {
        author: "Camille L.",
        text: "Le meilleur sérum régénérant que j'ai pu tester jusqu'ici. Ma peau sensible l'adore, l'absorption est instantanée et les résultats sur les rides du front sont impressionnants de jour en jour."
      }
    ];

    let currentIndex = 0;
    const authorTarget = document.getElementById('knr-author-target');
    const quoteTarget = document.getElementById('knr-quote-target');
    const btnPrev = document.getElementById('knr-btn-prev');
    const btnNext = document.getElementById('knr-btn-next');

    if (authorTarget && quoteTarget && btnPrev && btnNext) {
      
      const renderTestimonial = (index) => {
        // Transition de fondu
        authorTarget.style.opacity = '0';
        quoteTarget.style.opacity = '0';

        setTimeout(() => {
          authorTarget.textContent = testimonials[index].author;
          quoteTarget.textContent = `"${testimonials[index].text}"`;
          authorTarget.style.opacity = '1';
          quoteTarget.style.opacity = '1';
        }, 250);
      };

      btnPrev.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + testimonials.length) % testimonials.length;
        renderTestimonial(currentIndex);
      });

      btnNext.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % testimonials.length;
        renderTestimonial(currentIndex);
      });
    }

  });

  document.addEventListener('DOMContentLoaded', () => {
  const scrollContainer = document.querySelector('.knr-how-to-use-grid');
  const progressBar = document.getElementById('howToProgress');

  if (scrollContainer && progressBar) {
    scrollContainer.addEventListener('scroll', () => {
      const scrollTotal = scrollContainer.scrollWidth - scrollContainer.clientWidth;
      const scrollPos = scrollContainer.scrollLeft;
      const scrollRatio = scrollPos / scrollTotal;
      
      // Le mouvement doit couvrir les 2/3 restants de la barre (puisque le trait fait 1/3)
      const translateValue = scrollRatio * 200; 
      progressBar.style.transform = `translateX(${translateValue}%)`;
    });
  }
});

document.addEventListener('DOMContentLoaded', () => {
  const newsGrid = document.querySelector('.knr-news-grid');
  const newsBar = document.getElementById('newsProgressBar');

  if (newsGrid && newsBar) {
    newsGrid.addEventListener('scroll', () => {
      const scrollTotal = newsGrid.scrollWidth - newsGrid.clientWidth;
      const scrollPos = newsGrid.scrollLeft;
      const scrollRatio = scrollPos / scrollTotal;
      
      // Puisque le trait fait 25% (1/4), il doit bouger sur les 300% restants de sa largeur
      const translateValue = scrollRatio * 300; 
      newsBar.style.transform = `translateX(${translateValue}%)`;
    });
  }
});

document.addEventListener('DOMContentLoaded', () => {
  // On récupère toutes les colonnes du footer
  const footerCols = document.querySelectorAll('.knr-footer-col');

  footerCols.forEach(col => {
    const title = col.querySelector('.knr-footer-title');
    const list = col.querySelector('.knr-footer-links-list');

    // On n'active l'accordéon que si la colonne a un titre ET une liste
    if (title && list) {
      title.addEventListener('click', (e) => {
        // Uniquement sur mobile (< 991px)
        if (window.innerWidth <= 991) {
          e.preventDefault();
          
          const isActive = col.classList.contains('active');

          // 1. (Optionnel) Fermer les autres colonnes
          footerCols.forEach(c => c.classList.remove('active'));

          // 2. Si elle n'était pas active, on l'ouvre
          if (!isActive) {
            col.classList.add('active');
          }
          // Sinon elle reste fermée (effet toggle)
        }
      });
    }
  });
});
</script>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    /* 1. VARIATION FLOTTANTE */
    const floatSizeBtns = document.querySelectorAll('.knr-float-size-btn');
    const floatPriceEl = document.getElementById('knr-float-active-price');
    const floatVariantInput = document.getElementById('knr-float-variant-id-input');

    floatSizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        btn.parentElement.querySelectorAll('.knr-float-size-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const id = btn.getAttribute('data-id');
        const price = btn.getAttribute('data-price');

        if (id && floatVariantInput) {
          floatVariantInput.value = id;
        }
        if (price && floatPriceEl) {
          floatPriceEl.textContent = price;
        }
      });
    });

    /* 2. AJOUT PANIER AJAX DE LA FICHE FLOTTANTE */
    const floatForm = document.getElementById('knr-float-atc-form');
    const floatSubmitBtn = document.getElementById('knr-float-submit-btn');

    if (floatForm && floatSubmitBtn) {
      floatForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const variantId = floatVariantInput ? floatVariantInput.value : null;
        if (!variantId) return;

        const originalContent = floatSubmitBtn.innerHTML;
        floatSubmitBtn.innerHTML = "...";
        floatSubmitBtn.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              id: parseInt(variantId),
              quantity: 1
            })
          });

          const data = await response.json();

          if (response.ok) {
            // Mise à jour asynchrone du badge de panier global
            const cartResp = await fetch('/cart.js');
            const cart = await cartResp.json();
            const badge = document.querySelector('.knr-cart-badge');
            if (badge) badge.textContent = cart.item_count;

            floatSubmitBtn.innerHTML = "✓";
            setTimeout(() => {
              floatSubmitBtn.innerHTML = originalContent;
              floatSubmitBtn.disabled = false;
            }, 1500);
          } else {
            alert(data.description || "Erreur d'ajout au panier");
            floatSubmitBtn.innerHTML = originalContent;
            floatSubmitBtn.disabled = false;
          }
        } catch (err) {
          console.error("Erreur AJAX:", err);
          floatSubmitBtn.innerHTML = originalContent;
          floatSubmitBtn.disabled = false;
        }
      });
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
  const container = document.querySelector('.knr-reassurance-container');
  const dots = document.querySelectorAll('.reassurance-dot');

  if (container && dots.length > 0) {
    container.addEventListener('scroll', () => {
      // Calcule quel index est actuellement visible
      const index = Math.round(container.scrollLeft / container.offsetWidth);
      
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    });
  }
});
</script>

<!-- ==========================================
     C. LOGIQUE INTERACTIVE ET APPELS AJAX CART
     ========================================== -->
<script>
  document.addEventListener('DOMContentLoaded', () => {

    /* 1. SELECTION DES VARIANTS */
    const variantButtons = document.querySelectorAll('.knr-variant-btn');
    const variantIdInput = document.getElementById('knr-variant-id-input');
    const activePriceEl = document.getElementById('knr-active-price');
    const comparePriceEl = document.getElementById('knr-compare-price');

    variantButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        btn.parentElement.querySelectorAll('.knr-variant-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const id = btn.getAttribute('data-id');
        if (id && variantIdInput) {
          variantIdInput.value = id;
        }

        const price = btn.getAttribute('data-price');
        const comparePrice = btn.getAttribute('data-compare-price');

        if (price && activePriceEl) activePriceEl.textContent = price;
        if (comparePriceEl) {
          comparePriceEl.textContent = comparePrice ? comparePrice : '';
        }
      });
    });

    /* 2. LOGIQUE DES ACCORDÉONS */
    const accordionHeaders = document.querySelectorAll('.knr-accordion-header');

    accordionHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const currentItem = header.parentElement;
        const isActive = currentItem.classList.contains('active');

        document.querySelectorAll('.knr-accordion-item').forEach(item => {
          item.classList.remove('active');
          item.querySelector('.knr-accordion-content').style.display = 'none';
          item.querySelector('.knr-accordion-icon').textContent = '▼';
        });

        if (!isActive) {
          currentItem.classList.add('active');
          currentItem.querySelector('.knr-accordion-content').style.display = 'block';
          currentItem.querySelector('.knr-accordion-icon').textContent = '▲';
        }
      });
    });

    /* 3. LOGIQUE AJAX PANIER */
    async function updateCartBadge() {
      try {
        const response = await fetch('/cart.js');
        const cart = await response.json();
        const badge = document.querySelector('.knr-cart-badge');
        if (badge) {
          badge.textContent = cart.item_count;
        }
      } catch (err) {
        console.error("Erreur badge panier:", err);
      }
    }

    async function addToCartAJAX(variantId, buttonElement) {
      if (!variantId) return;
      const originalContent = buttonElement.innerHTML;
      
      buttonElement.innerHTML = "...";
      buttonElement.disabled = true;

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            id: parseInt(variantId),
            quantity: 1
          })
        });

        const data = await response.json();

        if (response.ok) {
          updateCartBadge();
          buttonElement.innerHTML = "✓";
          document.dispatchEvent(new CustomEvent('knr:open-cart'));
          setTimeout(() => {
            buttonElement.innerHTML = originalContent;
            buttonElement.disabled = false;
          }, 1500);
        } else {
          alert(data.description || "Erreur d'ajout au panier");
          buttonElement.innerHTML = originalContent;
          buttonElement.disabled = false;
        }
      } catch (err) {
        console.error("Erreur AJAX panier:", err);
        buttonElement.innerHTML = originalContent;
        buttonElement.disabled = false;
      }
    }

    const mainForm = document.getElementById('knr-main-atc-form');
    const mainSubmitBtn = document.getElementById('knr-main-submit-btn');

    if (mainForm) {
      mainForm.addEventListener('submit', (e) => {
        e.preventDefault();
        addToCartAJAX(variantIdInput ? variantIdInput.value : null, mainSubmitBtn);
      });
    }

    document.querySelectorAll('.knr-quick-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const variantId = btn.getAttribute('data-variant-id');
        addToCartAJAX(variantId, btn);
      });
    });

  });
</script>

