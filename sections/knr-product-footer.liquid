<style>
  /* ---------------------------------------------------------
     1. STRUCTURE DU PIED DE PAGE ET GRILLE GLOBALE
     --------------------------------------------------------- */
  .section-product-footer {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .knr-footer-section {
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
    background-color: #FCFBF9; /* Fond crème clair conforme */
    box-sizing: border-box;
    padding: 80px 0 40px 0;
    border-top: 1px solid #E0DDD6;
  }

  .knr-footer-container {
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    padding: 0 40px;
    display: flex;
    flex-direction: column;
    gap: 48px; /* Espacement vertical entre les sections du footer */
    box-sizing: border-box;
  }

  /* Grille supérieure : Les 4 colonnes de liens */
  .knr-footer-top-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    width: 100%;
    box-sizing: border-box;
  }

  .knr-footer-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .knr-footer-title {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #000000;
    margin: 0;
  }

  .knr-footer-links-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .knr-footer-link {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #000000;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .knr-footer-link:hover {
    opacity: 0.6;
  }

  .knr-about-text {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 12px;
    line-height: 20px;
    letter-spacing: -2%;
    color: #000000;
    margin: 0;
  }

  /* Certification Cosmos Bio */
  .knr-cert-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    margin-top: 16px;
    border-bottom: 0.8px solid #E0DDD6;
    padding-bottom: 16px;
  }

  .knr-cert-logo {
    height: 44px;
    width: auto;
    display: block;
  }

  .knr-cert-text {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: #000000;
    margin: 0;
  }

  .knr-cert-link {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #000000;
    text-decoration: none;
    border-bottom: 0.8px solid #000000;
    padding-bottom: 2px;
    display: inline-block;
    transition: opacity 0.2s;
    margin-top: 12px;
  }

  .knr-cert-link:hover {
    opacity: 0.6;
  }

  /* ---------------------------------------------------------
     2. ZONE INTERMÉDIAIRE : GIGANTESQUE LOGO "MAISON CÉLESTINE"
     --------------------------------------------------------- */
  .knr-footer-brand-row {
    width: 100%;
    border-top: 1px solid #E0DDD6;
    padding-top: 48px;
    box-sizing: border-box;
  }

  /* S'adapte de manière ultra-fluide de 48px à 130px selon l'écran de l'utilisateur */
  .knr-footer-brand-title {
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    font-size: clamp(48px, 9vw, 130px);
    line-height: 1;
    letter-spacing: -3px;
    text-transform: lowercase;
    color: #000000;
    margin: 0;
    text-align: left;
  }

  /* ---------------------------------------------------------
     3. BARRE DE COPYRIGHT ET DE RÉSEAUX (SUB-FOOTER)
     --------------------------------------------------------- */
  .knr-footer-sub-bar {
    width: 100%;
    border-top: 1px solid #E0DDD6;
    padding-top: 24px;
    margin-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
  }

  /* Sélecteurs Pays & Langues */
  .knr-footer-selectors-group {
    display: flex;
    gap: 24px;
  }

  .knr-footer-selector {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: #000000;
    cursor: pointer;
    user-select: none;
  }

  .knr-selector-chevron {
    width: 8px;
    height: 8px;
    color: #000000;
  }

  /* Copyright */
  .knr-footer-copyright {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 12px; /* Conforme Figma */
    line-height: 20px; /* Conforme Figma */
    letter-spacing: -2%; /* Conforme Figma */
    color: #000000;
    text-align: center;
    margin: 0;
  }

  /* Icônes de réseaux sociaux */
  .knr-footer-socials {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .knr-social-icon-link {
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .knr-social-icon-link:hover {
    opacity: 0.6;
  }

  /* ---------------------------------------------------------
     4. RESPONSIVE DESIGN (MOBILE / TABLETTE)
     --------------------------------------------------------- */
  @media (max-width: 991px) {
    .knr-footer-section {
      height: auto;
      padding: 40px 20px;
    }
    .knr-footer-container {
      padding: 0;
      gap: 32px;
    }
    .knr-footer-top-row {
      grid-template-columns: repeat(2, 1fr); /* 2x2 sur tablette */
      gap: 40px 24px;
    }
    .knr-footer-brand-title {
      letter-spacing: -1.5px;
    }
    .knr-footer-sub-bar {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }
    .knr-footer-selectors-group {
      justify-content: center;
    }
  }

  @media (max-width: 575px) {
    .knr-footer-top-row {
      grid-template-columns: 1fr; /* 1 colonne sur mobile */
      gap: 32px;
    }
  }
</style>

<div class="knr-footer-section">
  <div class="knr-footer-container">
    
    <!-- 1. GRILLE SUPÉRIEURE : LES LIENS -->
    <div class="knr-footer-top-row">
      <!-- Colonne 1 : Découvrir -->
      <div class="knr-footer-col">
        <h3 class="knr-footer-title">Découvrir</h3>
        <div class="knr-footer-links-list">
          <a href="/collections/all" class="knr-footer-link">Acheter</a>
          <a href="/pages/notre-histoire" class="knr-footer-link">Notre histoire</a>
          <a href="/pages/la-science" class="knr-footer-link">Science</a>
          <a href="/pages/presse" class="knr-footer-link">Presse</a>
          <a href="/pages/nos-adresses" class="knr-footer-link">Où nous trouver</a>
