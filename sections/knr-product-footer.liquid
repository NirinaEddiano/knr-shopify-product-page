        <!-- TikTok -->
        <a href="https://tiktok.com" class="knr-social-icon-link" aria-label="TikTok">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.17-2.86-.74-3.94-1.74-.22-.2-.4-.43-.59-.65v7.54c-.11 1.79-.83 3.61-2.22 4.75-1.57 1.35-3.84 1.83-5.83 1.25-2.61-.7-4.48-3.23-4.44-5.96.03-2.9 2.3-5.46 5.17-5.71.69-.07 1.39-.02 2.07.13v4.11c-.58-.19-1.22-.24-1.82-.12-1.24.22-2.2 1.34-2.23 2.59-.04 1.59 1.34 2.97 2.93 2.82 1.48-.12 2.58-1.47 2.47-2.94V.02z"/>
